EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
# Set this after linking the app to an Expo/EAS project (npx eas-cli init).
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
# Google Maps JavaScript API key. Keep the actual value in .env, never in GitHub.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
# Add this only in an EAS iOS development/App Store build; the app uses a local mock without it.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your_revenuecat_public_sdk_key
