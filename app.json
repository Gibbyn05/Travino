{
  "expo": {
    "name": "Reisefølge",
    "slug": "reisefolge",
    "scheme": "reisefolge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "Reisefølge bruker bilder du velger til minnene dine." }]
    ],
    "ios": { "supportsTablet": true, "bundleIdentifier": "no.reisefolge.app" },
    "web": { "bundler": "metro", "output": "single" },
    "experiments": { "typedRoutes": true }
  }
}
